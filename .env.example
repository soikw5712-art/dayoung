# ── Claude ──────────────────────────────────────────
ANTHROPIC_API_KEY=
# 기본 claude-sonnet-5. 비용을 줄이려면 claude-haiku-4-5
CLAUDE_MODEL=claude-sonnet-5

# ── 쿠팡 파트너스 Open API ──────────────────────────
# 비워 두면 '수동 모드': 파트너스 사이트에서 만든 링크 + 상품 정보를 직접 입력
# 키를 발급받아 채우면 자동으로 'API 모드'로 전환 (코드 수정 불필요)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# 딥링크에 붙는 채널 ID (선택)
COUPANG_SUB_ID=

# ── Threads (Meta 개발자 앱에서 발급) ───────────────
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ── Instagram Graph API (7주차) ────────────────────
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# 인스타 게시엔 이미지가 공개 URL이어야 함 (R2/S3 등)
PUBLIC_MEDIA_BASE_URL=

# ── 텔레그램 알림 ───────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 보안: 갱신된 토큰을 DB에 암호화 저장할 때 쓰는 키 ──
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ── 경로 (선택) ─────────────────────────────────────
DB_PATH=db.sqlite
OUTPUT_DIR=output
# 이미지 렌더링용 크롬 경로 (선택, 비우면 playwright install chromium 으로 받은 것 사용)
CHROMIUM_PATH=
# 영상 배경음악 (저작권 무료 음원만, 선택)
VIDEO_BGM_PATH=
